/**
 * Step 1: Fetch Order ID from Backend & Open Razorpay Checkout
 */
async function initiatePayment(holdResponse) {
    const payBtn = document.getElementById('confirm-payment-btn');
    payBtn.disabled = true;
    payBtn.textContent = "Loading...";

    try {
        // 1. Create Order on Backend
        const orderRes = await fetch('/api/payment/create-order', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${getAuthToken()}` // Ensure you have a helper to get JWT
            },
            body: JSON.stringify({ bookingId: currentBookingId })
        });

        const orderResult = await orderRes.json();

        if (!orderResult.success) {
            throw new Error(orderResult.message || "Failed to create payment order");
        }

        const orderData = orderResult.data;
        razorpayKey = orderData.keyId; // Save key for options

        // 2. Configure Razorpay Options
        const options = {
            key: orderData.keyId,
            amount: orderData.amount, // Amount in smallest currency unit (paise)
            currency: orderData.currency,
            name: "Movie Booking System",
            description: "Ticket Purchase",
            order_id: orderData.orderId,
            handler: function (response) {
                handlePaymentSuccess(response, currentBookingId);
            },
            prefill: {
                name: getCurrentUserName(), // Implement helper or hardcode for now
                email: getCurrentUserEmail(),
                contact: "9999999999"
            },
            theme: {
                color: "#E91E63"
            },
            modal: {
                ondismiss: function() {
                    // User closed the modal without paying
                    alert("Payment cancelled. Your seats are still held for a few more minutes.");
                    payBtn.disabled = false;
                    payBtn.textContent = `Pay ₹${holdResponse.data.totalAmount}`;
                }
            }
        };

        // 3. Open Checkout
        const rzp = new Razorpay(options);
        rzp.on('payment.failed', function (response) {
            alert("Payment Failed: " + response.error.description);
            payBtn.disabled = false;
            payBtn.textContent = `Retry Payment`;
        });
        
        rzp.open();

    } catch (error) {
        console.error("Payment initiation error:", error);
        alert("Error initiating payment: " + error.message);
        payBtn.disabled = false;
        payBtn.textContent = `Pay ₹${holdResponse.data.totalAmount}`;
        
        // If error is session expired, redirect
        if (error.message.includes("expired")) {
            window.location.reload(); 
        }
    }
}

/**
 * Step 2: Handle Success Callback from Razorpay
 */
async function handlePaymentSuccess(paymentResponse, bookingId) {
    const modal = document.getElementById('payment-modal');
    modal.querySelector('.modal-content').innerHTML = `
        <div style="text-align:center; padding: 20px;">
            <h3>Verifying Payment...</h3>
            <p>Please do not close this window.</p>
        </div>
    `;

    try {
        const verifyRes = await fetch('/api/payment/verify', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${getAuthToken()}`
            },
            body: JSON.stringify({
                bookingId: bookingId,
                razorpayPaymentId: paymentResponse.razorpay_payment_id,
                razorpayOrderId: paymentResponse.razorpay_order_id,
                razorpaySignature: paymentResponse.razorpay_signature
            })
        });

        const verifyResult = await verifyRes.json();

        if (verifyResult.success) {
            showBookingSuccess(verifyResult.data);
        } else {
            throw new Error(verifyResult.message || "Payment verification failed");
        }

    } catch (error) {
        console.error("Verification error:", error);
        alert("Payment might be successful but verification failed. Please contact support with ID: " + paymentResponse.razorpay_payment_id);
        // Optionally redirect to My Bookings to check status
        window.location.href = 'my-bookings.html'; 
    }
}

/**
 * Step 3: Show Final Success Screen
 */
function showBookingSuccess(bookingData) {
    const modal = document.getElementById('payment-modal');
    modal.querySelector('.modal-content').innerHTML = `
        <div style="text-align:center; padding: 20px;">
            <div style="color:green; font-size:48px; margin-bottom:10px;">✓</div>
            <h2>Booking Confirmed!</h2>
            <p>Booking ID: <strong>${bookingData.id}</strong></p>
            <p>Tickets sent to your email.</p>
            <button class="btn btn-primary" onclick="window.location.href='my-bookings.html'" style="margin-top:20px;">
                View My Bookings
            </button>
        </div>
    `;
}

/**
 * Helper: Cancel Booking (if user changes mind before paying)
 */
async function cancelBooking(bookingId) {
    if(!confirm("Are you sure? This will release your seats.")) return;

    try {
        await fetch(`/api/booking/${bookingId}/cancel`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${getAuthToken()}` }
        });
        document.getElementById('payment-modal').classList.add('hidden');
        alert("Seats released successfully.");
        window.location.reload();
    } catch (e) {
        alert("Failed to cancel: " + e.message);
    }
}

